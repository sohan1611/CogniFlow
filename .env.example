# --- LLM providers -----------------------------------------------------------
# Only ONE of these is needed. The chain tries them in COGNIFLOW_PROVIDER_ORDER
# and skips any without a key.
#
# Groq and Google both offer genuinely FREE API tiers that are ample here, so
# they lead by default and the project costs nothing to run.
GROQ_API_KEY=

# A SECOND free provider is not redundancy here, it is the difference between a
# demo that finishes live and one that falls back to templates halfway. Groq's
# free tier caps at 8,000 tokens per MINUTE, and one full tutoring run is roughly
# 35k tokens of RAG-grounded generation -- measured, not estimated: a run from a
# full quota still 429s partway. Google's free Flash tier has far more per-minute
# room, and the chain fails over automatically mid-run.
#
# Get one free at https://aistudio.google.com/apikey -- no billing account needed.
GOOGLE_API_KEY=
# Override if the default model name is retired. The chain is provider-agnostic,
# so a model that moves on is configuration, never a code change.
# COGNIFLOW_GEMINI_MODEL=gemini-2.0-flash

# OPTIONAL and NOT free. The Anthropic API is metered pay-per-token and is billed
# SEPARATELY from a Claude Pro/Max subscription - a subscription grants no API
# access. Leave blank unless you hold API credits and have chosen to spend them.
ANTHROPIC_API_KEY=

# Free tiers first. Set to "anthropic,groq,google" to promote the paid provider -
# worth doing for the video recording and the finale demo, not for development.
COGNIFLOW_PROVIDER_ORDER=groq,google,anthropic

# Anthropic model per role. Defaults to claude-sonnet-5 everywhere: generation and
# analysis sit well within its range, and ADAPT is validated by the deterministic
# guard regardless of which model proposed it. Uncomment to stretch a fixed credit.
# COGNIFLOW_MODEL_GENERATE=claude-sonnet-5
# COGNIFLOW_MODEL_ADAPT=claude-haiku-4-5
# COGNIFLOW_ANTHROPIC_MODEL=claude-sonnet-5
COGNIFLOW_DB_PATH=data/cogniflow.db
COGNIFLOW_CHECKPOINT_PATH=data/checkpoints.db
COGNIFLOW_CHROMA_PATH=data/chroma
COGNIFLOW_SANDBOX=subprocess
COGNIFLOW_LLM_REPLAY_CACHE=1
