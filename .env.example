# --- LLM providers -----------------------------------------------------------
# Only ONE of these is needed. The chain tries them in COGNIFLOW_PROVIDER_ORDER
# and skips any without a key.
#
# Groq and Google both offer genuinely FREE API tiers that are ample here, so
# they lead by default and the project costs nothing to run.
GROQ_API_KEY=
GOOGLE_API_KEY=

# OPTIONAL and NOT free. The Anthropic API is metered pay-per-token and is billed
# SEPARATELY from a Claude Pro/Max subscription - a subscription grants no API
# access. Leave blank unless you hold API credits and have chosen to spend them.
ANTHROPIC_API_KEY=

# Free tiers first. Set to "anthropic,groq,google" to promote the paid provider.
COGNIFLOW_PROVIDER_ORDER=groq,google,anthropic
COGNIFLOW_DB_PATH=data/cogniflow.db
COGNIFLOW_CHECKPOINT_PATH=data/checkpoints.db
COGNIFLOW_CHROMA_PATH=data/chroma
COGNIFLOW_SANDBOX=subprocess
COGNIFLOW_LLM_REPLAY_CACHE=1
