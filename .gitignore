.venv/
__pycache__/
*.py[cod]
.env
*.db
*.sqlite
*.sqlite3
# data/chroma/ is COMMITTED, deliberately. It is a derived artefact and normally
# would not be, but the deployed engine runs on a free tier whose disk does not
# survive a spin-down: without a shipped index it re-downloads an 80MB embedding
# model and re-embeds the whole curriculum on every wake, which measured at close
# to four minutes before anyone can be shown a first problem. It is 1.5MB, it is
# deterministic, and tests/test_rag.py fails if it drifts from data/knowledge.
!data/chroma/
!data/chroma/**
data/cogniflow.db
.cache/llm_replay/
.pytest_cache/
results/
.agents/codex-*.txt
build/

# The demo video lives on the v1.0-stage1 GitHub Release, not in git history.
# It is 41 MB; committing it would roughly double the clone a judge has to make
# for a file they can stream instead.
*.mp4
*.mov
*.mkv

# Editor/agent scaffolding, not project workflow. `python run.py ui` is the documented
# way to start the UI; this file only exists to point a preview pane at a fixed port.
.claude/
